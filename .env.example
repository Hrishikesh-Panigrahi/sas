# Copy to sas/.env (or .env in the project root) and fill in.
# Without DATABASE_NAME the app uses a local SQLite file (db.sqlite3).

SECRET_KEY=change-me
DEBUG=True

DATABASE_NAME=
DATABASE_USER=
DATABASE_PASS=
DATABASE_HOST=
DATABASE_PORT=5432

# Last day of teaching this semester, for forecasts and calendar feeds.
# SEMESTER_END=2026-11-30

# Optional; defaults to Asia/Kolkata.
# TIME_ZONE=Asia/Kolkata

# AI: paste an Anthropic API key to run insights and the timetable assistant on
# Claude. Leave it empty to use the built-in analyst (no key needed).
AI_TOKEN=
# AI_MODEL=claude-opus-5-5
